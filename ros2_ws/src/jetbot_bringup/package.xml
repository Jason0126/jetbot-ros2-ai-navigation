<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jetbot_bringup</name>
  <version>0.0.0</version>
  <description>
    Launch and configuration management for the JetBot
    ROS 2 AI Navigation and Monitoring Platform.
  </description>
  <maintainer email="asd910126@gmail.com">user</maintainer>
  <license>TODO: License declaration</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>ament_index_python</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
    <exec_depend>slam_toolbox</exec_depend>
    <exec_depend>nav2_bringup</exec_depend>

    <exec_depend>jetbot_monitor</exec_depend>
    <exec_depend>jetbot_hmi</exec_depend>
    <exec_depend>jetbot_perception</exec_depend>
  </export>
</package>
